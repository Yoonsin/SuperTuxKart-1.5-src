<?xml version="1.0"?>
<!-- [auto-item-fire] 실험용 씬 파일 -->
<!-- --auto-item-fire 플래그 실행 시 scene.xml 대신 로드됩니다. -->
<!-- 스폰 좌표 2개만 정의되어 있어 카트가 고정 위치에 배치됩니다. -->
<scene>
	<track model="stadium_track.spm" x="0" y="0" z="0"/>
	<sun  xyz="-40.13 115.85 -44.63" ambient="79 75 70"/>
	<sky-box texture="genericskybox_top.jpg genericskybox_bottom.jpg genericskybox_east.jpg genericskybox_west.jpg genericskybox_south.jpg genericskybox_north.jpg" sh-texture="genericskybox_west.jpg genericskybox_west.jpg genericskybox_west.jpg genericskybox_west.jpg genericskybox_west.jpg genericskybox_west.jpg"/>
	<camera far="1000.0"/>

	<!-- =================================================== -->
	<!-- [DUEL MODE] 실험용 고정 스폰 좌표 (2카트 전용)      -->
	<!-- 카트 1: 정면을 바라보며 중앙 배치                   -->
	<start x="0.30"  y="-61.20" z="0.00" h="0.00"/>
	<!-- 카트 2: 카트 1 반대 방향으로 5m 떨어진 위치         -->
	<start x="-0.30" y="-61.20" z="5.00" h="180.00"/>

	<!-- CTF 모드 동시 적용 좌표 (FFA/CTF 겸용)             -->
	<ctf-start x="0.30"  y="-61.20" z="0.00" h="0.00"/>
	<ctf-start x="-0.30" y="-61.20" z="5.00" h="180.00"/>
	<!-- =================================================== -->

	<red-flag  x="-36.87" y="-61.20" z="114.49" h="-0.00"/>
	<blue-flag x="-36.87" y="-61.20" z="-67.89" h="-0.00"/>
</scene>
